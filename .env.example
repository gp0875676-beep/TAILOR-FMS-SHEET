# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
AUTHORIZED_CHAT_IDS=123456789,987654321
AUTHORIZED_USER_IDS=111111111
TEST_CHAT_ID=

# Database (SQLite for local/dev; use PostgreSQL connection string on Render)
DATABASE_URL=sqlite:///./fms_state.db

# Behavior
DRY_RUN=false
LANGUAGE=both
ACTIVE_SHEET=Sheet1
LOG_LEVEL=INFO
TEMP_DIR=/tmp/fms_uploads

# Optional time-based re-evaluation between uploads
ENABLE_TIME_BASED_MONITORING=false
TIME_BASED_CHECK_INTERVAL_MINUTES=15
